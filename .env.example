COLLECTOR_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
KAFKA_OBSERVATIONS_TOPIC=station-observations-v2
KAFKA_METADATA_TOPIC=station-metadata
POLL_INTERVAL_SECONDS=60
H3_RESOLUTION=8
PORT=8000

# Read S3 archives for /history; independent of the Kafka collector.
HISTORY_ENABLED=true

S3_HISTORY_BUCKET=city-bikes-415989668005-us-east-2-an
S3_OBSERVATIONS_PREFIX=topics/station-observations-v2/
S3_METADATA_PREFIX=topics/station-metadata/
AWS_DEFAULT_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN= (only for temporary credentials)
